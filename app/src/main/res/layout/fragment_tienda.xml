<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp">
        <TextView android:id="@+id/tabTienda" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:gravity="center" android:text="🛒 Tienda" android:fontFamily="sans-serif-black"
            android:textColor="@color/texto" android:textSize="15sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/tabInventario" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:gravity="center" android:text="🎒 Inventario" android:fontFamily="sans-serif-black"
            android:textColor="@color/texto" android:textSize="15sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="16dp" />
</LinearLayout>
