<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/bg_panel"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true">

    <com.cesba.godzipet.vista.KaijuMiniView android:id="@+id/vistaHuevo"
        android:layout_width="80dp" android:layout_height="90dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/tvNombre" style="@style/Subtitulo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvDescripcion" style="@style/Cuerpo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <TextView android:id="@+id/tvBono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/atomico" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/tvCheck" android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:textSize="22sp" />
</LinearLayout>
