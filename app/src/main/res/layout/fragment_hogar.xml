<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="8dp" android:paddingBottom="16dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_panel" android:padding="3dp">
            <com.cesba.godzipet.vista.PetView android:id="@+id/petView"
                android:layout_width="match_parent" android:layout_height="320dp"
                android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvEstado" style="@style/Chip" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_margin="8dp" />
            <TextView android:id="@+id/tvLugar" style="@style/Chip" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="10dp"
                android:clickable="true" android:focusable="true" android:textColor="@color/crema"
                android:contentDescription="Escenario actual. Toca para viajar" />
        </FrameLayout>

        <LinearLayout android:id="@+id/panelStats" style="@style/Panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />

        <!-- Mensaje contextual que explica la reacción -->
        <TextView android:id="@+id/tvMensaje" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_panel"
            android:paddingStart="14dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="14dp"
            android:textColor="@color/texto" android:textSize="14sp" />

        <TextView style="@style/Subtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="6dp" android:text="Cuidados" />

        <GridLayout android:id="@+id/gridAcciones" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:columnCount="4" android:useDefaultMargins="false" />

        <LinearLayout android:id="@+id/filaExtras" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" />

        <TextView android:id="@+id/btnAliento" style="@style/Boton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="☢  ¡ALIENTO ATÓMICO!" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
