<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bg_panel"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="14dp">

    <TextView android:id="@+id/tvIcono" android:layout_width="54dp" android:layout_height="54dp"
        android:background="@drawable/bg_chip" android:gravity="center" android:textSize="28sp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/tvNombre" style="@style/Subtitulo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp" />
        <TextView android:id="@+id/tvDescripcion" style="@style/Cuerpo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" />
        <TextView android:id="@+id/tvExtra" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/atomico" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/btnAccion" style="@style/Boton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minWidth="92dp" android:minHeight="46dp" android:textSize="13sp" />
</LinearLayout>
