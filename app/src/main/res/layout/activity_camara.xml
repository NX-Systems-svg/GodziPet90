<?xml version="1.0" encoding="utf-8"?>
<!-- Godzilla en tu cuarto: vista previa de cámara + capa de realidad aumentada casera. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camaraRaiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.camera.view.PreviewView android:id="@+id/camaraVista"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <FrameLayout android:id="@+id/camaraCapa" android:layout_width="match_parent" android:layout_height="match_parent" />

    <TextView android:id="@+id/camaraAyuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="72dp"
        android:background="@drawable/camara_boton" android:paddingHorizontal="14dp" android:paddingVertical="8dp"
        android:textColor="#FFFFFFFF" android:textSize="13sp"
        android:text="Arrastra para mover · pellizca para escalar · dos dedos para girar" />

    <View android:id="@+id/camaraDestello" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#FFFFFFFF" android:alpha="0" android:importantForAccessibility="no" />

    <TextView android:id="@+id/camaraCerrar" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|start" android:layout_margin="12dp"
        android:background="@drawable/camara_boton" android:gravity="center"
        android:text="✕" android:textColor="#FFFFFFFF" android:textSize="20sp"
        android:contentDescription="Cerrar cámara" android:clickable="true" android:focusable="true" />

    <LinearLayout android:id="@+id/camaraBarra" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center"
        android:paddingTop="12dp" android:paddingBottom="20dp">
        <TextView android:id="@+id/camaraEspejo" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/camara_boton" android:gravity="center"
            android:text="↔" android:textColor="#FFFFFFFF" android:textSize="24sp"
            android:contentDescription="Invertir la dirección del kaiju" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/camaraObturador" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_marginHorizontal="28dp" android:background="@drawable/camara_obturador"
            android:gravity="center" android:text="📸" android:textSize="28sp"
            android:contentDescription="Tomar foto" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/camaraGirar" android:layout_width="56dp" android:layout_height="56dp"
            android:background="@drawable/camara_boton" android:gravity="center"
            android:text="🔄" android:textColor="#FFFFFFFF" android:textSize="22sp"
            android:contentDescription="Cambiar de cámara" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</FrameLayout>
