<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fondo" android:fitsSystemWindows="true">

    <!-- Barra superior: nombre, nivel, monedas y ajustes -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/contorno" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black" android:textColor="@color/amarillo" android:textSize="19sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tvForma" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/texto_sec" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/chipNivel" style="@style/Chip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="6dp"
            android:clickable="true" android:focusable="true" android:textColor="@color/atomico" />
        <TextView android:id="@+id/chipMonedas" style="@style/Chip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/amarillo" />
        <TextView android:id="@+id/btnAjustes" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="@color/texto"
            android:clickable="true" android:focusable="true" android:contentDescription="Configuración"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Alerta Kaiju (mecánica exclusiva) -->
    <LinearLayout android:id="@+id/bannerAlerta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="8dp"
        android:background="@drawable/bg_panel_alerta" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="10dp"
        android:paddingTop="8dp" android:paddingBottom="12dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🚨" android:textSize="24sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/tvAlerta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black" android:textColor="@android:color/white" android:textSize="14sp" />
            <TextView android:id="@+id/tvAlertaTiempo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFE0E0" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnDefender" style="@style/Boton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="44dp" android:background="@drawable/bg_boton_amarillo"
            android:textSize="13sp" android:text="DEFENDER" />
    </LinearLayout>

    <FrameLayout android:id="@+id/contenedor" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />

    <!-- Navegación inferior -->
    <LinearLayout android:id="@+id/barraNav" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_nav" android:orientation="horizontal"
        android:paddingTop="6dp" android:paddingBottom="6dp" />
</LinearLayout>
