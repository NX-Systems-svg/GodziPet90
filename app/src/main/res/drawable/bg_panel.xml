<?xml version="1.0" encoding="utf-8"?>
<!-- Panel estilo cómic: sombra dura desplazada + contorno grueso -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape><corners android:radius="16dp" /><solid android:color="@color/contorno" /></shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/superficie" />
            <stroke android:width="3dp" android:color="@color/contorno" />
        </shape>
    </item>
</layer-list>
